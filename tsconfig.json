{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "None",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["chrome"],
    "rootDir": "src",
    "outDir": "extension/js"
  },
  "include": ["src/**/*.ts"]
}
