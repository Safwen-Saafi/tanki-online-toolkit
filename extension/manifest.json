{
  "manifest_version": 3,
  "name": "Tanki Online ToolKit",
  "version": "1.6.0",
  "description": "Adds quality-of-life features to Tanki Online: flags players who change equipment mid-battle and keeps your chosen garage skins applied.",
  "content_scripts": [
    {
      "matches": [
        "*://*.tankionline.com/*",
        "*://tankionline.com/*"
      ],
      "js": [
        "js/injector.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.tankionline.com/*"
      ],
      "js": [
        "js/modules/language.js",
        "js/modules/garage_tab.js",
        "js/modules/change_counter.js",
        "js/modules/garage_skins.js",
        "js/modules/augments.js",
        "js/modules/kill_sounds.js",
        "js/modules/battle_music.js",
        "js/modules/grenade_sounds.js",
        "js/modules/weapon_sounds.js"
      ],
      "css": [
        "styles/change_counter.css",
        "styles/garage_skins.css",
        "styles/garage_cards.css",
        "styles/augments.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/skins.json",
        "data/killsounds.json",
        "data/weapon_sounds.json",
        "sounds/*",
        "icons/*"
      ],
      "matches": [
        "*://*.tankionline.com/*"
      ]
    }
  ]
}
