{
  "manifest_version": 3,
  "name": "Tanki Online ToolKit",
  "version": "1.7.0",
  "minimum_chrome_version": "119",
  "description": "Quality-of-life features for Tanki Online: augment info, hidden cards, old augment pictures, battle sounds, garage skins and more.",
  "content_scripts": [
    {
      "matches": [
        "*://*.tankionline.com/*",
        "*://tankionline.com/*"
      ],
      "js": [
        "js/injector.js",
        "js/modules/screens/shop_quick_buy.js",
        "js/modules/garage/showroom.js",
        "js/modules/lobby/lobby_looks.js",
        "js/modules/lobby/lobby_pass.js",
        "js/modules/lobby/drone_roasts.js",
        "js/modules/lobby/lobby.js",
        "js/modules/lobby/hangar_files.js",
        "js/modules/lobby/lobby_ui.js",
        "js/modules/lobby/lobby_search.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.tankionline.com/*"
      ],
      "js": [
        "js/modules/lobby/hangar_files_base.js",
        "js/modules/core/language.js",
        "js/modules/core/switches.js",
        "js/modules/screens/loading_screens.js",
        "js/modules/screens/debug_line.js",
        "js/modules/core/messages.js",
        "js/modules/core/battle.js",
        "js/modules/garage/showroom_floor.js",
        "js/modules/garage/showroom_glide.js",
        "js/modules/battle/battle_tab.js",
        "js/modules/core/old_pictures.js",
        "js/modules/core/garage_tab.js",
        "js/modules/battle/change_counter.js",
        "js/modules/garage/garage_skins.js",
        "js/modules/garage/augments.js",
        "js/modules/sounds/kill_sounds.js",
        "js/modules/sounds/battle_music.js",
        "js/modules/sounds/grenade_sounds.js",
        "js/modules/sounds/weapon_sounds.js",
        "js/modules/screens/settings_tab.js",
        "js/modules/battle/chat_translation.js"
      ],
      "css": [
        "styles/battle_tab.css",
        "styles/change_counter.css",
        "styles/garage_skins.css",
        "styles/augments.css",
        "styles/settings_tab.css",
        "styles/chat_translation.css",
        "styles/debug_line.css",
        "styles/shop_quick_buy.css",
        "styles/showroom.css",
        "styles/showroom_panels.css",
        "styles/showroom_items.css",
        "styles/showroom_tabs.css",
        "styles/showroom_lists.css",
        "styles/showroom_grenades.css",
        "styles/showroom_drones.css",
        "styles/showroom_protection.css",
        "styles/showroom_supplies.css",
        "styles/showroom_paints.css",
        "styles/lobby.css",
        "styles/lobby_ui.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/skins.json",
        "data/killsounds.json",
        "data/weapon_sounds.json",
        "data/old_pictures.json",
        "data/augment_ids.json",
        "old_pictures/*",
        "flags/*",
        "sounds/*",
        "icons/*",
        "showroom/*",
        "hangars/*",
        "lobby/*"
      ],
      "matches": [
        "*://*.tankionline.com/*"
      ]
    }
  ]
}
