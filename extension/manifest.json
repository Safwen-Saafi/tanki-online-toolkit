{
  "manifest_version": 3,
  "name": "Tanki Online ToolKit",
  "version": "1.4.0",
  "description": "Adds quality-of-life features to Tanki Online: flags players who change equipment mid-battle and keeps your chosen garage skins applied.",
  "content_scripts": [
    {
      "matches": [
        "*://*.tankionline.com/*",
        "*://tankionline.com/*"
      ],
      "js": [
        "js/injector.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.tankionline.com/*"
      ],
      "js": [
        "js/modules/change_counter.js",
        "js/modules/garage_skins.js"
      ],
      "css": [
        "styles/change_counter.css",
        "styles/garage_skins.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/skins.json"
      ],
      "matches": [
        "*://*.tankionline.com/*"
      ]
    }
  ]
}
